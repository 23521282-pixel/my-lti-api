# Copy to `.env` and fill in real values. Never commit the real file.

# Required. Secret used to sign the LTI `state` JWT (use a long random string).
LTI_STATE_SECRET=change-me-to-a-long-random-value

# Public base URL of this tool. Used for LTI redirect URIs and secure cookies.
TOOL_URL=http://localhost:3000

# Port the HTTP server listens on (default 3000).
PORT=3000

# PostgreSQL connection string used by Prisma.
# Development database:
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/lti_quiz_db
# Optional. Integration tests create and migrate this database; it must end
# with `_test` for the test runner to touch it.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/lti_quiz_test

# Optional cookie overrides for local development.
# COOKIE_SECURE=true
# COOKIE_PARTITIONED=true
